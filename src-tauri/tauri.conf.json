{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GATSI COMMS",
  "version": "0.1.0",
  "identifier": "com.gatsi.comms.desktop",
  "build": {
    "frontendDist": "../desktop-loading",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "GATSI COMMS",
        "width": 1280,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/nodejs/**/*",
      "resources/nextjs/**/*"
    ],
    "windows": {
      "wix": null,
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
